{
  "name": "marc-tracker",
  "version": "38.0.0",
  "private": true,
  "description": "M/ARC workout, recovery and coaching tracker (Android/PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/sw-version.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:prepare": "node scripts/prepare-heart-rate-android.mjs",
    "gate": "node scripts/screenshot-gate.mjs",
    "convert-backup": "esbuild scripts/convert-legacy-backup.ts --bundle --platform=node --format=esm --alias:@=./src --log-level=warning --outfile=node_modules/.cache/convert-backup.mjs && node node_modules/.cache/convert-backup.mjs",
    "logo": "esbuild src/theme/themes.ts --bundle --format=esm --outfile=node_modules/.cache/logo-themes.mjs --log-level=warning && esbuild src/svg/logo.ts --bundle --format=esm --outfile=node_modules/.cache/logo-svg.mjs --log-level=warning && node scripts/render-logo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@preact/signals": "^2.0.0",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@preact/preset-vite": "^2.10.0",
    "body-muscles": "^1.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "playwright": "^1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
